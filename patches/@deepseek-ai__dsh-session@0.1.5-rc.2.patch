# pnpm patch for @deepseek-ai/dsh-session@0.1.5-rc.2 — ALIAS-ONLY compatibility re-exports.
#
# WHY: 0.1.5-rc.2 does not re-export `isJsonValue` / `snapshotJsonValue` at the package root, but a
# plugin pinned to an older dsh family still imports them from `@deepseek-ai/dsh-session`:
# `dsh-computer-use@0.2.0` depends on `@deepseek-ai/dsh-tools@0.1.1-rc.2`, whose `lib/index.js`
# does `import { isJsonValue, snapshotJsonValue } from "@deepseek-ai/dsh-session"`.
#
# WHAT: appended re-exports only, sourced from `@deepseek-ai/dsh-util-values` (a direct dependency
# of dsh-session). No behaviour change.
#
# REMOVAL CONDITION: delete this patch and its `patchedDependencies` entry as soon as
# `@deepseek-ai/dsh-session` exports `isJsonValue` / `snapshotJsonValue` itself, or no consumer
# imports them from that package any more — i.e. once `@deepseek-ai/dsh-tools` takes them from
# `@deepseek-ai/dsh-util-values` directly and every plugin that pinned the old `dsh-tools`
# (currently `dsh-computer-use@0.2.0`) has moved with it.
#
diff --git a/lib/index.js b/lib/index.js
index 0d2ca05..b70583f 100644
--- a/lib/index.js
+++ b/lib/index.js
@@ -1624,3 +1624,5 @@ var SessionStore = class extends Service {
 };
 //#endregion
 export { KNOWN_SESSION_EVENT_TYPES, SESSION_FORMAT_VERSION, Session, SessionForkError, SessionId, SessionLogOffset, SessionPreparation, SessionSeq, SessionStore, SessionStore as default, TOOL_NOT_STARTED, TOOL_OUTCOME_UNKNOWN, adoptSessionEvent, canonicalHeader, decodeSeqRanges, deriveEventMessage, encodeSeqRanges, foldRequestHeader, foldSurface, headerEquals, interruptedTurnClosers, isAppendSurfaceEvent, isReplacementSurfaceEvent, isSurfaceEligibleType, isSurfaceEvent, snapshotSessionEvent };
+
+export { isJsonValue, snapshotJsonValue } from "@deepseek-ai/dsh-util-values"
